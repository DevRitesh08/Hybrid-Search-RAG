# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Optional: OpenAI ablation ─────────────────────────────────────────────────
# OPENAI_API_KEY=your-openai-api-key-here

# ── Embedding / Reranker model names (defaults shown) ─────────────────────────
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── ChromaDB ─────────────────────────────────────────────────────────────────
# CHROMA_PATH=.chroma
# CHROMA_HOST=localhost   # used when CHROMA_MODE=http
# CHROMA_PORT=8000
# CHROMA_MODE=local       # local | http

# ── Retrieval defaults ────────────────────────────────────────────────────────
# RETRIEVAL_TOP_K=20
# RERANK_TOP_K=5
# RRF_K=60
# RRF_WEIGHT_DENSE=0.7
# RRF_WEIGHT_SPARSE=0.3

# ── Generation ────────────────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-2.0-flash
# JUDGE_MODEL=gemini-2.0-flash
# CONFIDENCE_THRESHOLD=0.35

# ── Chunking ─────────────────────────────────────────────────────────────────
# CHUNK_STRATEGY=structural    # fixed | structural | semantic
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
