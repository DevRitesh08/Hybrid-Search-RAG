# Hybrid Search RAG — HuggingFace Docs
# https://github.com/DevRitesh08/Hybrid-Search-RAG

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ── uv / pip / virtual environments ──────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/
*.venv/
.cache/
*.pth

# ── Data (never commit raw or processed corpus) ──────────────────────────────
data/raw/
data/processed/
data/scifact/
!data/golden/
!data/golden/*.jsonl

# ── Index stores ─────────────────────────────────────────────────────────────
.chroma/
*.chroma/
chroma_data/
bm25_*.json
!src/hybrid_rag/index/

# ── Model caches ─────────────────────────────────────────────────────────────
models/
.cache/huggingface/
*.bin
*.safetensors
*.onnx
*.pt

# ── Env / secrets ─────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
!*.env.example

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE / Scratch ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
*.orig

# ── Testing / coverage / linter caches ────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
nosetests.xml
*.log

# ── Reports (committed selectively) ──────────────────────────────────────────
# reports/ is committed; individual large CSVs are ignored
reports/*.csv.gz

# ── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/

# ── Docker ────────────────────────────────────────────────────────────────────
*.tar

# ── Agent scratchpads & Study guides ──────────────────────────────────────────
.agents/
study/
